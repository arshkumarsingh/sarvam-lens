# results/wiki/router.pt (19 MB): the J++ k-means router, uploaded with the lenses.
# The small *_stamp.json / *.json provenance files next to them stay in git.
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
lenses/*.pt

